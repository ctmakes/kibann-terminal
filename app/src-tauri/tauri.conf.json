{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kibann Terminal",
  "version": "0.1.0-rc.1",
  "identifier": "dev.kibann.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kibann Terminal",
        "width": 960,
        "height": 600,
        "minWidth": 320,
        "minHeight": 200,
        "backgroundColor": "#181818",
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMDhBNjk3RDA3RkJDMzIKUldReXZIL1FsNllJSURwYmNvbCtTQmZha0duaFAzWjErU0RPTlk2TjBVYWJXK21Za2Z1aU1sUVgK",
      "endpoints": ["https://github.com/ctmakes/kibann-terminal/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A terminal for running many coding agents at once",
    "copyright": "Copyright © 2026 ctmakes",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
