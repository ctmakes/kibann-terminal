# LF in every checkout, Windows too: sources and docs are read with
# include_str! and split on "\n", and scripts run in sh.
* text=auto eol=lf

# Recorded terminal output and the frames made from it are compared byte for
# byte: keep their line endings as they are on every platform (Windows
# checkouts would turn LF into CRLF).
crates/term/recordings/** -text
crates/agent/tests/fixtures/** -text
app/src/dev/recordings/** -text
fixtures/paint/** -text
fixtures/layout/** -text
